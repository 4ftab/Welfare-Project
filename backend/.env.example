# Copy to .env for local development. On Render, add the same names under Environment.
# Never commit real values.

PORT=5000
NODE_ENV=development

# MySQL (Aiven in production; SSL is enabled automatically for *.aivencloud.com hosts)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=nojawan_welfare

# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Public address of the website, without a trailing slash (Safepay redirects donors back here)
FRONTEND_URL=http://localhost:5173
# Extra browser origins allowed to call the API, comma separated (full origin: scheme + host + port, no path).
# Already allowed without listing: FRONTEND_URL, the Vercel site, http://localhost:5173 and http://127.0.0.1:5173,
# and (outside production) the Vite preview server http://localhost:4173. Wildcards are never accepted.
# CORS_ORIGINS=http://localhost:4174,https://staging.example.org

# Email OTP via Brevo HTTPS API. Use an API key (starts with xkeysib-), NOT an SMTP key (xsmtpsib-).
BREVO_API_KEY=
MAIL_FROM=nojawan.itehad.welfare@gmail.com
# Local development only: print OTP codes to the console instead of emailing them (ignored when NODE_ENV=production)
MAIL_DEV_LOG_OTP=false
# Optional: how long to wait for Brevo before giving up on one email, in milliseconds (default 15000)
# BREVO_TIMEOUT_MS=15000
# Tests only (ignored in production): send to a local fake instead of Brevo
# BREVO_API_URL=http://127.0.0.1:5058/v3

# Safepay: "sandbox" for testing, "production" for real payments. Keys must match the environment.
SAFEPAY_ENV=sandbox
SAFEPAY_PUBLIC_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
# Payment methods shown to donors; add easypaisa,jazzcash only after Safepay enables them on your account
SAFEPAY_CHANNELS=card
# Optional tuning
SAFEPAY_PENDING_EXPIRY_HOURS=24
SAFEPAY_RECONCILE_MINUTES=5
